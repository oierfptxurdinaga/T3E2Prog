<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry excluding="Erronka2/images/|Erronka2/images/" kind="src" path="src"/>
	<classpathentry kind="src" path="src/Erronka2/images"/>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="output" path="bin"/>
</classpath>
